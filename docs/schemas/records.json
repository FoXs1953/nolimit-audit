{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nolimit.example/schemas/records.json",
  "$defs": {
    "ledger": {
      "type": "object",
      "properties": {
        "row_id": {
          "$ref": "common.json#/$defs/id"
        },
        "timestamp": {
          "$ref": "common.json#/$defs/timestamp"
        },
        "account": {
          "enum": [
            "cash",
            "receivable",
            "revenue",
            "suspense"
          ]
        },
        "debit_minor": {
          "type": "integer",
          "minimum": 0
        },
        "credit_minor": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "$ref": "common.json#/$defs/currency"
        },
        "entity_id": {
          "$ref": "common.json#/$defs/id"
        },
        "invoice_id": {
          "oneOf": [
            {
              "$ref": "common.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "payment_id": {
          "oneOf": [
            {
              "$ref": "common.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "journal_id": {
          "$ref": "common.json#/$defs/id"
        }
      },
      "required": [
        "row_id",
        "timestamp",
        "account",
        "debit_minor",
        "credit_minor",
        "currency",
        "entity_id",
        "invoice_id",
        "payment_id",
        "journal_id"
      ],
      "additionalProperties": false
    },
    "invoices": {
      "type": "object",
      "properties": {
        "doc_id": {
          "$ref": "common.json#/$defs/id"
        },
        "invoice_id": {
          "$ref": "common.json#/$defs/id"
        },
        "entity_id": {
          "$ref": "common.json#/$defs/id"
        },
        "issued_at": {
          "$ref": "common.json#/$defs/timestamp"
        },
        "due_at": {
          "$ref": "common.json#/$defs/timestamp"
        },
        "currency": {
          "$ref": "common.json#/$defs/currency"
        },
        "total_minor": {
          "type": "integer",
          "minimum": 0
        },
        "source_ref": {
          "$ref": "common.json#/$defs/id"
        },
        "line_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              },
              "unit_price_minor": {
                "type": "integer",
                "minimum": 0
              },
              "amount_minor": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "description",
              "quantity",
              "unit_price_minor",
              "amount_minor"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "doc_id",
        "invoice_id",
        "entity_id",
        "issued_at",
        "due_at",
        "currency",
        "total_minor",
        "source_ref",
        "line_items"
      ],
      "additionalProperties": false
    },
    "payments": {
      "type": "object",
      "properties": {
        "doc_id": {
          "$ref": "common.json#/$defs/id"
        },
        "payment_id": {
          "$ref": "common.json#/$defs/id"
        },
        "timestamp": {
          "$ref": "common.json#/$defs/timestamp"
        },
        "currency": {
          "$ref": "common.json#/$defs/currency"
        },
        "amount_minor": {
          "type": "integer"
        },
        "invoice_refs": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/id"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "kind": {
          "enum": [
            "receipt",
            "refund"
          ]
        }
      },
      "required": [
        "doc_id",
        "payment_id",
        "timestamp",
        "currency",
        "amount_minor",
        "invoice_refs",
        "kind"
      ],
      "additionalProperties": false
    },
    "fx": {
      "type": "object",
      "properties": {
        "row_id": {
          "$ref": "common.json#/$defs/id"
        },
        "date": {
          "$ref": "common.json#/$defs/date"
        },
        "source_currency": {
          "$ref": "common.json#/$defs/currency"
        },
        "target_currency": {
          "$ref": "common.json#/$defs/currency"
        },
        "rate": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
        }
      },
      "required": [
        "row_id",
        "date",
        "source_currency",
        "target_currency",
        "rate"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ledger"
    },
    {
      "$ref": "#/$defs/invoices"
    },
    {
      "$ref": "#/$defs/payments"
    },
    {
      "$ref": "#/$defs/fx"
    }
  ]
}
