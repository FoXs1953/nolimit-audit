{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nolimit.example/schemas/action.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "tool": {
          "const": "list_records"
        },
        "table": {
          "$ref": "common.json#/$defs/table"
        },
        "cursor": {
          "oneOf": [
            {
              "$ref": "common.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "tool",
        "table"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "tool": {
          "const": "get_record"
        },
        "table": {
          "$ref": "common.json#/$defs/table"
        },
        "id": {
          "$ref": "common.json#/$defs/id"
        }
      },
      "required": [
        "tool",
        "table",
        "id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "tool": {
          "const": "get_document"
        },
        "doc_id": {
          "$ref": "common.json#/$defs/id"
        }
      },
      "required": [
        "tool",
        "doc_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "tool": {
          "const": "calculator"
        },
        "expression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[0-9.+*/()\\s-]+$"
        }
      },
      "required": [
        "tool",
        "expression"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "tool": {
          "const": "submit"
        },
        "findings": {
          "$ref": "findings.json"
        }
      },
      "required": [
        "tool",
        "findings"
      ],
      "additionalProperties": false
    }
  ]
}
