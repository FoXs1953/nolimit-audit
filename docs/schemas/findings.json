{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nolimit.example/schemas/findings.json",
  "type": "object",
  "properties": {
    "episode_id": {
      "$ref": "common.json#/$defs/id"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "common.json#/$defs/id"
          },
          "affected_ids": {
            "type": "array",
            "items": {
              "$ref": "common.json#/$defs/id"
            }
          },
          "claimed_amount_minor": {
            "type": "integer"
          },
          "currency": {
            "$ref": "common.json#/$defs/currency"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "$ref": "common.json#/$defs/id"
            },
            "maxItems": 10
          },
          "explanation": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "type",
          "affected_ids",
          "claimed_amount_minor",
          "currency",
          "evidence_ids",
          "explanation"
        ],
        "additionalProperties": false
      },
      "maxItems": 30
    }
  },
  "required": [
    "episode_id",
    "findings"
  ],
  "additionalProperties": false
}
